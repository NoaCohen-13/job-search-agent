{
  "manifest_version": 3,
  "name": "JobAgent — Save to Pipeline",
  "version": "1.0",
  "description": "Save LinkedIn jobs directly to your JobAgent pipeline with one click",
  "host_permissions": [
    "https://www.linkedin.com/*",
    "http://localhost:3000/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/jobs/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
